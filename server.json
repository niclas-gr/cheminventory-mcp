{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.niclas-gr/cheminventory-mcp",
  "title": "ChemInventory",
  "description": "Search and manage a ChemInventory chemical inventory through its API",
  "repository": {
    "url": "https://github.com/niclas-gr/cheminventory-mcp",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "cheminventory-mcp",
      "version": "1.0.0",
      "runtimeHint": "uvx",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "CHEMINVENTORY_TOKEN",
          "description": "ChemInventory API token",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "CHEMINVENTORY_URL",
          "description": "Installation URL for dedicated or self-hosted servers",
          "default": "https://app.cheminventory.net"
        }
      ]
    }
  ]
}
